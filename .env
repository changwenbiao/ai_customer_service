# ============================================================================
# 智能客服系统 - 生产环境配置
# 用法：复制此文件为 .env，然后修改配置
#   cp .env.example .env
# ============================================================================

# ============================================================================
# 镜像配置（必填）
# ============================================================================
# 镜像仓库地址（阿里云 ACR 或其他镜像仓库）
IMAGE_REGISTRY=change_me_acr

# 镜像标签（版本号，如 v1.0.0 或 latest）
IMAGE_TAG=v1.0.0

# ============================================================================
# 服务端口配置
# ============================================================================
# HTTP 服务端口（访问入口）
HTTP_PORT=8080

# ============================================================================
# MySQL 配置
# ============================================================================
MYSQL_ROOT_PASSWORD=change_me_mysql_pwd
MYSQL_DATABASE=cs_biz_db
# Go 业务库 DSN（容器内由 compose 覆盖为 mysql:3306 服务名，此处为宿主机/外部访问示例）
CS_MYSQL_DSN=root:change_me_mysql_pwd@tcp(127.0.0.1:3306)/cs_biz_db?charset=utf8mb4&parseTime=True&loc=Local

# ============================================================================
# PostgreSQL 配置
# ============================================================================
POSTGRES_USER=change_me_postgres_user
POSTGRES_PASSWORD=change_me_postgres_pwd
POSTGRES_DB=cs_agent_db
# Postgres（容器内部由 compose 覆盖为 postgres:5432，此处为宿主机/外部访问示例）
POSTGRES_DSN=postgresql://change_me_postgres_user:change_me_postgres_pwd@127.0.0.1:5432/cs_agent_db
# Qdrant（容器内部由 compose 覆盖为 http://qdrant:6333，此处为宿主机/外部访问示例）
QDRANT_URL=http://127.0.0.1:6333
# Go 业务接口（容器内部由 compose 覆盖为 http://go:8080，此处为宿主机/外部访问示例）
GO_BUSINESS_API=http://127.0.0.1:8080
# Agent 服务地址（容器内由 compose 覆盖为 http://agent:8000，此处为宿主机/外部访问示例）
CS_AGENT_URL=http://127.0.0.1:8000
# redis配置
REDIS_URL=redis://redis:6379/0

# ============================================================================
# 检索配置（Agent：search_kb / test-query）
# ============================================================================
# 是否启用 cross-encoder 重排（bge-reranker-v2-m3）。默认 true，镜像构建时已预下载模型
ENABLE_RERANK=true
# rerank 候选池大小：先 hybrid 召回 top-N，再 rerank 取 top-k（N 越大越准但越慢）
# CPU 单次前向约 3~5s，N 直接决定耗时；10 候选实测 30~50s 会顶到 Go 侧超时，默认 5
RERANK_CANDIDATE_N=5
# 是否启用检索相似度阈值过滤（默认 true 开启；设为 false 则不做任何分数过滤）
ENABLE_RETRIEVAL_SCORE_THRESHOLD=true
# 检索相似度阈值：低于该分数的 chunk 被过滤，全部被滤掉则返回"未找到相关信息"。
# 开关打开后阈值始终生效（无"等于0不过滤"特殊分支），默认 0——dense/hybrid 分数均为正时自然不过滤，
# 但 rerank 链路对数似然可为负，默认 0 也会滤掉负分 chunk。
# 量纲随链路变化：dense cosine 约 0.5~0.8 / hybrid RRF 约 0.5~1.0 / rerank 对数似然可正可负。
RETRIEVAL_SCORE_THRESHOLD=0
# 分片策略（实验 E：标题路径前缀）：是否给每个 chunk 前置「文档标题 > 小节标题」路径
# true=标题感知分片（默认）；false=回退纯 RecursiveCharacterTextSplitter 基线。
# 分片是索引期动作，改完必须重新导入知识库（python3 python_agent/eval/kb_import.py）才生效
ENABLE_CHUNK_TITLE_PREFIX=true

# ============================================================================
# 内部 API 鉴权 Token（Go 与 Agent 之间通信）
# 建议修改为随机字符串（如 openssl rand -hex 24）
# ============================================================================
INTERNAL_API_TOKEN=change_me_internal_token

# ============================================================================
# 种子租户 app_secret（首次启动写入 tenants 表；此后以 DB 为准，后台可改）
# 对应 config.yaml auth.tenants 中的租户（TENANT_{TENANT_ID大写}_SECRET）
# 生产务必改为强密码，且与 .env 保持一致（数据库内为 sha256 哈希，不存明文）
# ============================================================================
TENANT_T_ADMIN_SECRET=admin_secret
TENANT_T_DEMO_SECRET=demo_secret

# ============================================================================
# P0-4 密钥管理（必填）：数据库内 API Key 的 AES 加密主密钥
# 生产环境必须设置，且与 .env 中的 MODEL_KEY_ENCRYPT_KEY 保持一致
# 生成方式：openssl rand -hex 32
# 轮换：替换后需同步重新加密存量 key（见运维文档"密钥轮换"章节）
# ============================================================================
MODEL_KEY_ENCRYPT_KEY=change_me_32bytes_hex_key_please_replace

# ============================================================================
# P0-3 CORS 白名单（可选）：第三方站点 XHR 直连客服 API 时放行的来源域名
# 逗号分隔；iframe 嵌入方式无需配置（同源）。默认仅放行本地开发地址
# 示例：CORS_ALLOW_ORIGINS=https://shop.example.com,https://mall.example.com
# ============================================================================
CORS_ALLOW_ORIGINS=

# ============================================================================
# 可观测性配置（可选，启动 observability profile 时使用）
# ============================================================================
# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# 链路追踪（默认关闭，启动 Jaeger 后配置）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
