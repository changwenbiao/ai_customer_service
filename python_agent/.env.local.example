# 复制为同目录 .env.local 后按需修改（.env.local 已 gitignore，不入库）
# main.py 先加载仓库根目录 .env，再用本文件覆盖；容器部署不读取本文件

REDIS_URL=redis://127.0.0.1:6379/0
# 相对 python_agent 工作目录；也可写绝对路径
KB_FILE_DIR=./data/kb_files
# 本地默认关闭 rerank，避免首次启动下载大模型
ENABLE_RERANK=false
# 本地只起 1 个索引 worker，方便调试
KB_INDEX_WORKERS=1
# 本地 Go 网关端口（8080 被 nginx 容器占用）
GO_BUSINESS_API=http://127.0.0.1:8082
