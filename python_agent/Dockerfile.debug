# 仅供远程调试使用，不要用于生产
# 与 python_agent/Dockerfile 的差异：
#   1) 额外安装 debugpy
#   2) 以 debugpy 监听 5678 的方式启动，供 IDE attach（不阻塞服务启动）
FROM python:3.13-slim AS builder

ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai \
    HF_HOME=/opt/huggingface

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# 先装 CPU 版 torch（~200MB，比默认 CUDA 版 ~2GB 小很多），再装其余依赖
RUN pip install --no-cache-dir --prefix=/install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && pip install --no-cache-dir --prefix=/install "debugpy>=1.8,<2"

COPY . .

# 预下载 bge-reranker-v2-m3 模型，避免运行时首次调用才下载
# pip 用 --prefix=/install 安装，需指定 PYTHONPATH 才能 import
RUN PYTHONPATH=/install/lib/python3.13/site-packages python -c \
    "from FlagEmbedding import FlagReranker; FlagReranker('BAAI/bge-reranker-v2-m3', use_fp16=False)"

# -------------------------- 运行阶段 runtime（最终镜像） --------------------------
FROM python:3.13-slim

# 关闭源文件校验提示，避免日志刷屏（仅调试镜像）
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai \
    PYDEVD_DISABLE_FILE_VALIDATION=1 \
    HF_HOME=/opt/huggingface

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /build /app
# 复制预下载的 huggingface 模型缓存
COPY --from=builder /opt/huggingface /opt/huggingface

# 8000 业务端口 / 5678 debugpy 调试端口
EXPOSE 8000 5678

# 不加 --wait-for-client：容器启动即开始提供服务，IDE 可随时 attach/断开重连
# -Xfrozen_modules=off：关闭 frozen modules，否则可能漏掉断点
CMD ["python", "-Xfrozen_modules=off", "-m", "debugpy", "--listen", "0.0.0.0:5678", "main.py"]
