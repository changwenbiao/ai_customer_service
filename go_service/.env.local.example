# 复制为同目录 .env.local 后按需修改（.env.local 已 gitignore，不入库）
# Go 启动时由 config.LoadConfig 自动加载；已存在的进程环境变量优先

# 宿主机视角 MySQL（容器内是 mysql:3306）；密码取根目录 .env 的 MYSQL_ROOT_PASSWORD
CS_MYSQL_DSN=root:change_me_mysql_pwd@tcp(127.0.0.1:3306)/cs_biz_db?charset=utf8mb4&parseTime=True&loc=Local
# 本地 Agent 地址
CS_AGENT_URL=http://127.0.0.1:8000
# 与根目录 .env 保持一致
INTERNAL_API_TOKEN=change_me_internal_token
MODEL_KEY_ENCRYPT_KEY=change_me_32bytes_hex_key_please_replace
# 容器 Redis（docker-compose.local.yaml 已映射 6379）
REDIS_ADDR=127.0.0.1:6379
# 本地 Go 监听端口（8080 被 nginx 占用，8081 被 embedding 占用）
CS_SERVER_PORT=:8082
# 相对 go_service 工作目录；也可写绝对路径
RSA_PRIVATE_KEY_PATH=../data/rsa_private.pem
CS_MSG_FILE_ROOT=../data/msg_files
